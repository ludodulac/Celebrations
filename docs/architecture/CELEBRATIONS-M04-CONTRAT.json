    },
    {
      "method": "GET",
      "path": "/api/editor-open-draft",
      "visibility": "authenticated"
    },
    {
      "method": "POST",
      "path": "/api/editor-open-draft",
      "visibility": "authenticated"
    },
    {
      "method": "GET",
      "path": "/api/editor-publication",
      "visibility": "public-published-only"
    },
    {
      "method": "POST",
      "path": "/api/editor-publication",
      "visibility": "authenticated"
    },
    {
      "method": "GET",
      "path": "/api/editor-media",
      "visibility": "authenticated"
    },
    {
      "method": "POST",
      "path": "/api/editor-media",
      "visibility": "authenticated"
    },
    {
      "method": "GET",
      "path": "/media/new/*",
      "visibility": "policy-checked-media"
    },
    {
      "method": "GET",
      "path": "/media/*",
      "visibility": "historical-media"
    },
    {
      "method": "GET",
      "path": "/letter/*",
      "visibility": "historical-documents"
    }
  ],
