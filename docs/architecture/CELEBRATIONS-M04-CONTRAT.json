{
  "schemaVersion": 1,
  "project": "CÉLÉBRATIONS / Ronde des Archanges Universelle",
  "status": "PROPOSED_TARGET_NOT_IMPLEMENTED",
  "auditBaseCommit": "6f37459fe8752c66f1225267a8137362f5b4750b",
  "currentPublicBaselineCommit": "7cbfdbd79e2b40f8f4ca4b46dbc97d47e26b742d",
  "publishedHostnames": [
    "ronde-des-archanges-universelle.eu",
    "www.ronde-des-archanges-universelle.eu"
  ],
  "runtime": {
    "keepEntrypoint": "migration/cloudflare/production-worker.mjs",
    "keepRuntime": "Cloudflare Worker + D1 + R2 + static assets",
    "keepCsp": "Nonce-based inline script/style until equivalence established",
    "keepNoFrameworkMigration": true,
    "activeEditorR2Bucket": "celebrations-exit-staging",
    "activeEditorR2Object": "editor-trials/server-drafts-v1.json",
    "historicalMediaR2Bucket": "celebrations-exit-production",
    "newUploadsPrefix": "editor-trials/uploads/",
    "database": "D1 production (historic records and read-only catalogue)",
    "publicReadIsolation": "Only server-filtered published snapshot; never serve private draft state"
  },
  "boundaries": [
    {
      "id": "domain",
      "target": "migration/cloudflare/app/domain/",
      "dependsOn": [],
      "responsibility": "Pure immutable editor model, id/date/url validation, block types, visibility and stage slugs"
    },
    {
      "id": "application",
      "target": "migration/cloudflare/app/application/",
      "dependsOn": [
        "domain"
      ],
      "responsibility": "Pure commands, history, selectors, change-set and publication policies"
    },
    {
      "id": "ports",
      "target": "migration/cloudflare/app/ports/",
      "dependsOn": [
        "domain",
        "application"
      ],
      "responsibility": "Contracts for editor store, catalogue, legacy content and auth; no concrete Cloudflare APIs"
    },
    {
      "id": "adapters",
      "target": "migration/cloudflare/app/adapters/",
      "dependsOn": [
        "domain",
        "application",
        "ports"
      ],
      "responsibility": "R2 ETag store, D1 legacy read, media storage, auth; HTTPS/HTTP mapping"
    },
    {
      "id": "admin",
      "target": "migration/cloudflare/app/admin/",
      "dependsOn": [
        "domain",
        "application",
        "ports"
      ],
      "responsibility": "Admin bootstrap, DOM controllers, modals, media chooser, drag/drop, inline editor and CSS"
    },
    {
      "id": "public",
      "target": "migration/cloudflare/app/public/",
      "dependsOn": [
        "domain",
        "application",
        "ports"
      ],
      "responsibility": "Public navigation, published read model, renderers, media gallery and CSS"
    },
    {
      "id": "compat",
      "target": "migration/cloudflare/app/compat/",
      "dependsOn": [
        "domain",
        "ports"
      ],
      "responsibility": "Legacy page ids, routes and original mail/media URLs without migration"
    },
    {
      "id": "composition",
      "target": "migration/cloudflare/app/composition/",
      "dependsOn": [
        "domain",
        "application",
        "ports",
        "adapters",
        "admin",
        "public",
        "compat"
      ],
      "responsibility": "Server route adapters, HTML response and explicit composition, with existing Worker entrypoint unchanged"
    }
  ],
  "frozenExternalRoutes": [
    {
      "method": "GET",
      "path": "/",
      "visibility": "public"
    },
    {
      "method": "GET",
      "path": "/mercredi/",
      "visibility": "public"
    },
    {
      "method": "GET",
      "path": "/mediatheque-generale",
