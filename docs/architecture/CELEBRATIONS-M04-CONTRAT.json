    "preserveDraftsAndPublishedSplit": true,
    "preserveCurrentSaveSemantics": true,
    "preserveConditionalEtagWritesAnd409": true,
    "preserveNoUndoOfRemotePublication": true,
    "preserveOldEmailedLinks": true,
