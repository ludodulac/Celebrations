  "targetOperations": {
    "loadPrivate": "GET /api/editor-open-draft?celebration={id} requires editor session",
    "savePrivate": "POST /api/editor-open-draft with expectedRevision; use R2 CAS; 409 on collision",
    "publish": "POST /api/editor-publication; explicit visibility change only by authorized administrator",
    "loadPublic": "GET /api/editor-publication?celebration={id}; return only published pages and public media",
    "mediaUpload": "POST /api/editor-media?action=upload; retain current accepted MIME list and size checks",
    "documentUndo": "Local editor-only bounded snapshot/commands; never revert remote publish"
  },
  "mandatoryReleaseGates": {
    "exactCurrentWorkerRollbackVerified": false,
    "independentlyRecoverableD1CurrentSnapshotVerified": false,
    "mediaBinaryRecoveryCoverageVerified": false,
    "independentOffCloudflareBackupVerified": false,
    "mission02VisualParityRequired": true,
    "noProductionDeploymentFromThisBranch": true
  },
  "missions": {
